# AI Premium Shop - Environment Configuration

# Site Configuration
SITE_URL=https://aipremiumshop.com
SITE_NAME=AI Premium Shop
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aipremiumshop_db

# Authentication
AUTH_SECRET=your_auth_secret_here
JWT_SECRET=your_jwt_secret_here

# Payment Processing
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_API_KEY=your_nagad_api_key

# Email Service
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
ADMIN_EMAIL=admin@aipremiumshop.com

# WhatsApp Integration
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_PHONE_NUMBER=+880XXXXXXXXX

# Cloudflare R2 (for assets) — S3-compatible API, bucket already provisioned as "aips-media" (APAC).
# R2_ACCOUNT_ID: Cloudflare dashboard -> R2 -> Overview (right sidebar)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 -> Manage R2 API Tokens -> Create API Token
# R2_PUBLIC_URL: the bucket's connected custom domain (e.g. https://media.aipremiumshop.com)
#   or its enabled r2.dev public URL -- both are set up in R2 -> aips-media -> Settings -> Public Access
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aips-media
R2_PUBLIC_URL=https://media.aipremiumshop.com

# AIPS frontend analytics (Vite exposes only VITE_* variables to client code).
# Leave blank to keep the corresponding tracker disabled even after cookie consent.
VITE_GA_ID=
VITE_FB_PIXEL_ID=
SENTRY_DSN=

# Legacy/non-AIPS aliases retained for compatibility with other workspace tooling.
# The AIPS Vite frontend does not read these names.
ANALYTICS_ID=
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

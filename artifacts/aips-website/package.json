{
  "name": "aips-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf dist/public && mkdir -p dist/public && find dist -mindepth 1 -maxdepth 1 -not -name public | while read f; do cp -r \"$f\" dist/public/; done",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy": "bash deploy.sh",
    "deploy:win": "deploy.bat"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.11.0",
    "mixpanel-browser": "^2.52.0",
    "next": "16.2.4",
    "openai": "^4.52.0",
    "postgres": "^3.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}

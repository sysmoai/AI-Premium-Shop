{
  "name": "workspace",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:cloudflare": "pnpm --filter @workspace/aips-landing run build && node scripts/prepare-cloudflare.mjs",
    "deploy:cloudflare": "npx wrangler deploy",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  },
  "pnpm": {
    "overrides": {
      "systeminformation": "5.33.16",
      "axios": "^1.20.0",
      "body-parser": "^2.4.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.9",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "follow-redirects": "^1.16.2",
      "hono": "^4.13.16",
      "ip-address": "^10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "markdown-it": "^14.3.3",
      "postcss@<8.5.23": "^8.5.23",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "source-map-js": "^1.2.2",
      "undici": "^7.30.1"
    }
  }
}
